# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API).
# Use SOMENTE a chave "anon public". Nunca coloque a service_role no frontend.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key
# Integração com a loja virtual (somente no servidor/Vercel; mesma chave do plugin Sheik ERP Conector)
LOJA_WEBHOOK_SECRET=chave-aleatoria-de-64-caracteres
# Endereço do site WordPress (botão "Adicionar no site" e lista de categorias do site)
LOJA_SITE_URL=https://www.seusite.com.br
